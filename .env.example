DATABASE_URL=postgres://fidget:fidget@db:5432/fidget
JWT_SECRET=change-me-in-production
RUST_LOG=info
POSTGRES_USER=fidget
POSTGRES_PASSWORD=fidget
POSTGRES_DB=fidget
#RTMP_URL=rtmp://media-server:1935/live

## CLOUDFRONT CONFIGURATIONS
# Production: AWS deployment runs on a single EC2 instance hosting the
# Docker Compose stack; HLS segments live in an S3 bucket fronted by
# CloudFront. CLOUDFRONT_DOMAIN below points at the CloudFront
# distribution that pulls from the S3 origin.
CLOUDFRONT_DOMAIN=https://d1wp4v4rt1bxg5.cloudfront.net
RTMP_URL=rtmp://rtmp.fidgetlive.com/live

# Bootstrap admin account on backend startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Public hostname browsers use to reach the WebTransport ingest endpoint.
# Added to the QUIC self-signed cert's SAN list so Chrome's tightened
# `serverCertificateHashes` rules don't reject the handshake. Leave unset
# for local docker (the loopback SANs cover it).
# PUBLIC_HOSTNAME=fidgetlive.com

# --- WebRTC / WHEP playback (low-latency viewer path) ---
# Public ICE candidate SRS advertises to browsers. The browser dials
# UDP 8000 at this address for the WebRTC media path, so it must be
# reachable from wherever the streamer/viewer is running.
#   - Local Docker Desktop (macOS/Windows): set this to your host's
#     LAN IP (e.g. `ipconfig getifaddr en0` on macOS). The 127.0.0.1
#     default does NOT work because Docker Desktop's userland UDP NAT
#     drops the loopback path, which causes DTLS to hang and viewers
#     to never see video.
#   - Linux host docker: 127.0.0.1 is usually fine for same-machine.
#   - Production (EC2): set to the EC2 instance's public IP / DNS and
#     open UDP 8000 in the security group.
CANDIDATE=127.0.0.1
# Default STUN server returned by /api/config/rtc. Override if you want a
# private STUN, or set to empty string to disable.
STUN_URL=stun:stun.l.google.com:19302
# Optional TURN relay for viewers behind symmetric NAT. Required for full
# coverage in production. Start the bundled coturn with
# `docker compose --profile turn up`.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TURN_REALM=fidget.local
